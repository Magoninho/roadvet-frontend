# Base URL of the RoadVet Django API, WITHOUT a trailing slash and WITHOUT
# "/sync" or "/auth" — those are appended by the client (src/services/api/client.ts,
# src/database/sync/api.ts). The backend exposes:
#   POST {URL}/auth/register
#   POST {URL}/auth/login
#   POST {URL}/auth/refresh
#   GET/POST {URL}/sync
#   POST {URL}/anexos/{id}/upload
#
# Examples:
#   Web / iOS simulator:        http://localhost:8000/api
#   Android emulator:           http://10.0.2.2:8000/api
#   Physical device on same Wi-Fi: http://<your-machine-LAN-IP>:8000/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api
